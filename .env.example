# ===================================
# Google Authentication
# ===================================

# Get this from Google Cloud Console > Credentials > OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Get this from Apps Script deployment
# After deploying Auth.gs as a Web App, copy the URL here
VITE_APPS_SCRIPT_AUTH_URL=YOUR_APPS_SCRIPT_DEPLOYMENT_URL_HERE

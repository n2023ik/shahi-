# ============================================
# GOOGLE AUTHENTICATION
# ============================================
# Get from: Google Cloud Console > Credentials > OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# ============================================
# GOOGLE APPS SCRIPT ENDPOINTS
# ============================================
# Auth Script: Deploy Auth.gs as Web App
VITE_APPS_SCRIPT_AUTH_URL=YOUR_APPS_SCRIPT_AUTH_URL_HERE

# Dashboard Data Script: Deploy DashboardData.gs as Web App
VITE_GOOGLE_SHEETS_API_URL=YOUR_DASHBOARD_DATA_DEPLOYMENT_URL_HERE

# ============================================
# GOOGLE SHEETS CONFIGURATION
# ============================================
# Sheet names (leave as-is or update if your sheet names differ)
VITE_SHEET_DASHBOARD=Shahi Dashboard
VITE_SHEET_TRIP_DETAILS=Shahi Reverse PickupTrip Detail
VITE_SHEET_ALLOWED_USERS=AllowedUsers

# ============================================
# API CONFIGURATION
# ============================================
# API timeout in milliseconds
VITE_API_TIMEOUT=15000

# Enable debug logging (true/false)
VITE_DEBUG_MODE=false

# ============================================
# SUPABASE (Optional - if using Supabase)
# ============================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
